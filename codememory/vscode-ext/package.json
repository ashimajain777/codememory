{
  "name": "codememory-hover",
  "displayName": "CodeMemory Hover",
  "description": "Shows hover cards for tracked hacks in CodeMemory",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "CodeMemory",
      "properties": {
        "codememory.resultsPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the CodeMemory results.json file"
        }
      }
    }
  }
}
